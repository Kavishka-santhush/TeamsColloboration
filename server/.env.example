# ------------------------------------------------------------------
# Team Communication Platform - Server Environment Variables
# Copy this file to .env and fill in real values. Do NOT commit .env
# ------------------------------------------------------------------

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://user:password@localhost:5432/team_communication

# --- Clerk (Authentication) ---
CLERK_SECRET_KEY=your_clerk_secret_key
CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_WEBHOOK_SECRET=your_clerk_webhook_secret

# --- OpenRouter (AI) ---
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o
OPENROUTER_FALLBACK_MODEL=openai/gpt-4o-mini

# --- File Upload (Multer local storage) ---
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=100

# --- Email (Nodemailer) ---
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_pass
MAIL_FROM="Team Communication <no-reply@teamcomm.local>"

# --- Server ---
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# --- Security ---
ENCRYPTION_KEY=your_32_char_encryption_key
JWT_SECRET=your_jwt_secret_for_internal_tokens

# --- WebRTC / TURN (voice & video calls) ---
TURN_SERVER_URL=turn:your_turn_server
TURN_USERNAME=your_turn_username
TURN_PASSWORD=your_turn_password

# --- Stripe (subscription billing) ---
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# --- Integrations ---
GIPHY_API_KEY=your_giphy_api_key
